DJANGO_ENV=development
SECRET_KEY=your-secret-key-here-minimum-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.saas.id

DATABASE_URL=postgresql://saas_user:saas_pass@localhost:5432/saas_db

REDIS_URL=redis://localhost:6379/0

# Generate keys: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

SYNC_SECRET_KEY=your-sync-secret-minimum-32-chars

MIDTRANS_SERVER_KEY=Mid-server-xxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

SENDGRID_API_KEY=SG.xxxxx

SENTRY_DSN=https://xxx@sentry.io/xxx
